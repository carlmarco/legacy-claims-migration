<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>  <!-- LibraryImport source generator (getrusage) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- One source of truth for the engine's bookkeeping DDL, shared with the Python engine. -->
    <EmbeddedResource Include="..\etl\sql\engine.sql" LogicalName="engine.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etl.Engine\Etl.Engine.csproj" />
  </ItemGroup>

</Project>
